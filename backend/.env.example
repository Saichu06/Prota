# ==============================================================================
# Prota Backend - Environment Variables Template
# Copy this file to .env (do not commit .env to version control)
# ==============================================================================

# Database Connection
DB_URL=jdbc:postgresql://localhost:5432/prota
DB_USERNAME=postgres
DB_PASSWORD=your_secure_password_here

# Active Spring Profile (e.g., dev, test, prod)
SPRING_PROFILES_ACTIVE=dev

# Server Configuration
PORT=8080

# CORS Allowed Origins (comma-separated URLs)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Security / Token Secrets (future authentication phases)
# JWT_SECRET=change_me_to_at_least_256_bits_random_secret
# JWT_ACCESS_EXPIRATION_SECONDS=900
# JWT_REFRESH_EXPIRATION_SECONDS=2592000

# Google Gemini API Key (Backend AI Integration: Prota Nutrition Assistant & Camera Estimation)
GEMINI_API_KEY=your_gemini_api_key_here

